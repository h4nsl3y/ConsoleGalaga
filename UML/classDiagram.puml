package "ConsoleGalaga.Models.Characters.Vessels" {
    interface IVessel {
    }

    class Vessel {
        - _hBorder: Tuple<int, int>
        - _vBorder: Tuple<int, int>
        + Health: int
        + PositionX: int
        + PositionY: int
        + Shoot: bool
        + Vessel(health: int, hBorder: Tuple<int,int>, vBorder: Tuple<int,int>)
        + Behaviour(): void
        + GetSymbol(): string
        + HitWall(): void
    }

    IVessel --|> IGameElement
    IVessel --|> ICharacter
    IVessel --|> IShooter
    Vessel ..|> IVessel
}

package "ConsoleGalaga.Models.Characters.Enemy" {
    interface IEnemy {
        + IsAlive: bool
        + Size: int
        + OccupiesPosition(x: int, y: int): bool
    }

    class Enemy {
        - _hBorder: Tuple<int, int>
        - _vBorder: Tuple<int, int>
        - _random: Random
        + Health: int
        + PositionX: int
        + PositionY: int
        + IsAlive: bool
        + Size: int
        + Enemy(health: int, hBorder: Tuple<int,int>, vBorder: Tuple<int,int>)
        + GetSymbol(): string
        + OccupiesPosition(x: int, y: int): bool
        + Behaviour(): void
        + HitWall(): void
    }

    IEnemy --|> IGameElement
    IEnemy --|> ICharacter
    Enemy ..|> IEnemy
}

' Package: ConsoleGalaga - Bullets
package "ConsoleGalaga.Models.Bullets" {
    interface IBullet {
        + HasHit: bool
    }

    abstract class Bullet {
        # _hBorder: Tuple<int, int>
        # _vBorder: Tuple<int, int>
        + PositionX: int
        + PositionY: int
        + HasHit: bool
        + Bullet(x: int, y: int, hBorder: Tuple<int,int>, vBorder: Tuple<int,int>)
        + {abstract} GetSymbol(): string
        + {abstract} Behaviour(): void
        + HitWall(): void
    }

    class IceBullet {
        - _movementDirection: int
        - _originalXAxis: int
        + IceBullet(x: int, y: int, hBorder: Tuple<int,int>, vBorder: Tuple<int,int>)
        + GetSymbol(): string
        + Behaviour(): void
        - Divert(): int
    }

    class SlashBullet {
        + SlashBullet(x: int, y: int, hBorder: Tuple<int,int>, vBorder: Tuple<int,int>)
        + GetSymbol(): string
        + GetSymbol(index: BulletFrameEnum): string
        + Behaviour(): void
    }

    IBullet --|> IGameElement
    Bullet ..|> IBullet
    IceBullet --|> Bullet
    SlashBullet --|> Bullet
    SlashBullet ..> BulletFrameEnum
}

' Package: ConsoleGalaga - Enums
package "ConsoleGalaga.Enums" {
    enum BulletFrameEnum {
        frame1 = 1
        frame2 = 2
    }
}

}

' Data access and database interaction
SQLExecutor --> GalagaDatabase : opens SQL connection
GameEngine ..> GalagaDatabase : persists score


' Package: Controller - REST API
package "Controller" #F5B7B1 {
    class AppUserController <<ApiController>> {
        - _appUserBL: IAppUserBL
        - _logger: ILogger
        + AppUserController(appUserBL: IAppUserBL, logger: ILogger)
        + Authenticate(request: AppUserModel): Task<IActionResult>
        + Register(request: IAppUserModel): Task<IActionResult>
        + GetAllUsers(page: int, limit: int): Task<IActionResult>
        + Delete(userId: int): Task<IActionResult>
        + Update(request: IAppUserModel): Task<IActionResult>
    }

    class PlayerController <<ApiController>> {
        - _playerBL: IPlayerBL
        - _logger: ILogger
        + PlayerController(playerBL: IPlayerBL, logger: ILogger)
        + Add(playerName: string): Task<IActionResult>
        + GetPlayer(playerId: int): Task<IActionResult>
        + GetAllPlayers(page: int, limit: int): Task<IActionResult>
        + Delete(playerId: int): Task<IActionResult>
        + Update(request: IPlayerModel): Task<IActionResult>
    }

    class ScoreRecordController <<ApiController>> {
        - _scoreRecordBL: IScoreRecordBL
        - _logger: ILogger
        + ScoreRecordController(scoreRecordBL: IScoreRecordBL, logger: ILogger)
        + Add(request: IScoreRecordModel): Task<IActionResult>
        + GetScoreRecord(scoreRecordId: int): Task<IActionResult>
        + GetTopScoreRecords(page: int, limit: int): Task<IActionResult>
        + Delete(scoreRecordId: int): Task<IActionResult>
        + Update(request: IScoreRecordModel): Task<IActionResult>
    }

    class LeaderBoardController <<ApiController>> {
        - _leaderBoardService: ILeaderBoardService
        - _logger: ILogger
        + LeaderBoardController(leaderBoardService: ILeaderBoardService, logger: ILogger)
        + GetTopScores(page: int, limit: int): Task<IActionResult>
    }

    AppUserController --> IAppUserBL
    PlayerController --> IPlayerBL
    ScoreRecordController --> IScoreRecordBL
    LeaderBoardController --> ILeaderBoardService
    AppUserController --> ILogger
    PlayerController --> ILogger
    ScoreRecordController --> ILogger
    LeaderBoardController --> ILogger
}

' Package: WebPageLibrary - React frontend and host
package "WebPageLibrary" #E8DAEF {
    class ReactUiController <<MvcController>> {
        - {static} GalagaIndexPath: string
        + GetGalagaUi(): IActionResult
    }

    class App <<ReactComponent>> {
        - showAdmin: boolean
        + App(): JSX.Element
    }

    class BaseApi <<AxiosClient>> {
        + baseURL: string
        + headers: object
    }

    interface IAppUserService {
        + authenticate(username: string, password: string): Promise<boolean>
        + register(username: string, password: string): Promise<boolean>
        + getAllUsers(page: number, limit: number): Promise<IGridData<IAppUser>>
        + deleteUser(userId: number): Promise<boolean>
        + updateUser(username: string, password: string): Promise<boolean>
    }

    class AppUserService {
        + authenticate(username: string, password: string): Promise<boolean>
        + register(username: string, password: string): Promise<boolean>
        + getAllUsers(page: number, limit: number): Promise<IGridData<IAppUser>>
        + deleteUser(userId: number): Promise<boolean>
        + updateUser(username: string, password: string): Promise<boolean>
    }

    interface IPlayerService {
        + addPlayer(playerName: string): Promise<number>
        + getPlayer(playerId: number): Promise<IPlayer>
        + deletePlayer(playerId: number): Promise<boolean>
        + editPlayer(playerId: number, playerName: string): Promise<boolean>
        + getAllPlayers(page: number, limit: number): Promise<IGridData<IPlayer>>
    }

    class PlayerService {
        + addPlayer(playerName: string): Promise<number>
        + getPlayer(playerId: number): Promise<IPlayer>
        + deletePlayer(playerId: number): Promise<boolean>
        + editPlayer(playerId: number, playerName: string): Promise<boolean>
        + getAllPlayers(page: number, limit: number): Promise<IGridData<IPlayer>>
    }

    interface IScoreRecordService {
        + addScoreRecord(playerId: number, score: number): Promise<boolean>
        + getScoreRecord(scoreRecordId: number): Promise<IScoreRecord>
        + getTopScoreRecords(page: number, limit: number): Promise<IScoreRecord[]>
        + deleteScoreRecord(scoreRecordId: number): Promise<boolean>
        + editScoreRecord(scoreRecordId: number, playerId: number, score: number): Promise<boolean>
    }

    class ScoreRecordService {
        + addScoreRecord(playerId: number, score: number): Promise<boolean>
        + getScoreRecord(scoreRecordId: number): Promise<IScoreRecord>
        + getTopScoreRecords(page: number, limit: number): Promise<IScoreRecord[]>
        + deleteScoreRecord(scoreRecordId: number): Promise<boolean>
        + editScoreRecord(scoreRecordId: number, playerId: number, score: number): Promise<boolean>
    }

    interface ILeaderboardService {
        + getLeaderboardRecords(page: number, limit: number): Promise<IGridData<IRecord>>
    }

    class LeaderboardService {
        + getLeaderboardRecords(page: number, limit: number): Promise<IGridData<IRecord>>
    }

    class IPlayer <<FrontendModel>> {
        + playerId: number
        + playerName: string
        + dateCreated: string
    }

    class IScoreRecord <<FrontendModel>> {
        + scoreRecordId: number
        + playerId: number
        + score: number
        + lastModified: string
    }

    class IAppUser <<FrontendModel>> {
        + username: string
        + password: string
    }

    class IRecord <<FrontendModel>> {
        + name: string
        + score: number
    }

    class IGridData <<FrontendModel>>

    class Area <<ReactComponent>>
    class Navbar <<ReactComponent>>
    class Particles <<ReactComponent>>

    ReactUiController ..> App : redirects to
    App --> Area
    App --> Navbar
    App --> Particles
    AppUserService ..|> IAppUserService
    PlayerService ..|> IPlayerService
    ScoreRecordService ..|> IScoreRecordService
    LeaderboardService ..|> ILeaderboardService
    AppUserService --> BaseApi
    PlayerService --> BaseApi
    ScoreRecordService --> BaseApi
    LeaderboardService --> BaseApi
    AppUserService ..> AppUserController : HTTP
    PlayerService ..> PlayerController : HTTP
    ScoreRecordService ..> ScoreRecordController : HTTP
    LeaderboardService ..> LeaderBoardController : HTTP
}

@enduml